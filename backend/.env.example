# 复制为 backend/.env 后按环境填写；仓库不保存真实密钥。
# Flask CLI 会在安装了 python-dotenv 时自动读取本文件。
APP_ENV=development
DATABASE_URL=sqlite:///instance/app.sqlite
UPLOAD_DIR=instance/uploads
# 生产环境必须填写，禁止使用仓库内的开发默认值
SECRET_KEY=
COOKIE_SECURE=0
# SPEC-017 单张图片识别限时（秒），超时返回 503 且不保留任务；留空用默认 5 秒
RECOGNITION_TIMEOUT_SECONDS=
